generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  ANALYZING
  READY
  HOOKS_READY
  SCRIPTS_READY
  MEDIA_READY
  EXPORT_READY
  FAILED
}

enum JobType {
  ANALYZE_WEBSITE
  GENERATE_CONCEPTS
  GENERATE_MEDIA
  SAVE_EXPORT
  GENERATE_HOOKS
  GENERATE_SCRIPTS
  PREVIEW_REELS
  RENDER_REELS
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ReviewDecision {
  LIKED
  REJECTED
}

enum SupportRequestStatus {
  NEW
  OPEN
  RESOLVED
}

enum RenderUsageStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum SocialPlatform {
  TIKTOK
}

enum SocialConnectionStatus {
  CONNECTED
  DISCONNECTED
  NEEDS_RECONNECTION
}

enum SocialPublicationStatus {
  VALIDATING
  PUBLISHING
  PUBLISHED
  DELIVERED_TO_TIKTOK
  FAILED
}

enum SocialPublicationDeliveryMode {
  DIRECT
  TIKTOK_DRAFT
}

model User {
  id                String           @id @default(cuid())
  clerkId           String?          @unique
  email             String           @unique
  passwordHash      String?
  name              String?
  role              UserRole         @default(USER)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  projects          Project[]        @relation("OwnedProjects")
  freeHookLimit     Int              @default(24)
  freeAccessEndedAt DateTime?
  freeOnboardingProject Project?     @relation("FreeOnboardingProject")
  allowedEmailsMade AllowedEmail[]   @relation("AllowedEmailCreatedBy")
  dodoCustomerId    String?          @unique
  subscriptions     Subscription[]
  renderUsageReservations RenderUsageReservation[]
  complimentaryAccess ComplimentaryAccess? @relation("ComplimentaryAccessRecipient")
  complimentaryAccessGranted ComplimentaryAccess[] @relation("ComplimentaryAccessGrantor")
  supportRequests   SupportRequest[]
  socialProfile     SocialProfile?
  socialAccounts    SocialAccount[]
}

model ComplimentaryAccess {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation("ComplimentaryAccessRecipient", fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  startsAt    DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  reason      String?
  grantedById String?
  grantedBy   User?     @relation("ComplimentaryAccessGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startsAt, expiresAt, revokedAt])
}

model SupportRequest {
  id         String               @id @default(cuid())
  email      String
  message    String
  userId     String?
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  status     SupportRequestStatus @default(NEW)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([email])
  @@index([userId])
}

model Subscription {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dodoCustomerId          String
  dodoSubscriptionId      String    @unique
  dodoProductId           String
  scheduledDodoProductId  String?
  status                  String
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtNextBillingDate Boolean   @default(false)
  latestProviderEventAt   DateTime
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId, dodoProductId, status])
  @@index([dodoCustomerId])
}

model DodoWebhookEvent {
  webhookId String   @id
  eventType String
  eventAt   DateTime
  createdAt DateTime @default(now())
}

model RenderUsageReservation {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationJobId    String            @unique
  generationJob      GenerationJob     @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  requestedCount     Int
  consumedCount      Int               @default(0)
  status             RenderUsageStatus @default(RESERVED)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([userId, billingPeriodStart, billingPeriodEnd, status])
}

model AllowedEmail {
  id          String   @id @default(cuid())
  email       String   @unique
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("AllowedEmailCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}

model Project {
  id                  String           @id @default(cuid())
  userId              String?
  user                User?            @relation("OwnedProjects", fields: [userId], references: [id], onDelete: Cascade)
  freeOnboardingOwnerId String?         @unique
  freeOnboardingOwner User?             @relation("FreeOnboardingProject", fields: [freeOnboardingOwnerId], references: [id], onDelete: SetNull)
  website             String
  normalizedWebsite   String
  status              ProjectStatus    @default(DRAFT)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  selectedConceptId   String?          @map("selectedHookId")
  selectedCharacterId String?          @map("selectedCharacterId")
  selectedCharacter   Json?            @map("selectedCharacter")
  creatorSelection    Json?            @map("creatorSelection")
  hookPreferences     Json?            @map("hookPreferences")
  brandDemoCaptionsEnabled Boolean @default(true)
  defaultBrandDemoAssetId String?
  brandProfileConfirmedAt DateTime?
  selectedConcept     HookConcept?     @relation("ProjectSelectedConcept", fields: [selectedConceptId], references: [id], onDelete: SetNull)
  brandProfile        BrandProfile?
  websiteAnalysis     WebsiteAnalysis?
  concepts            HookConcept[]
  mediaAssets         MediaAsset[]
  exportState         ProjectExport?
  jobs                GenerationJob[]
  socialPublications  SocialPublication[]

  @@unique([userId, normalizedWebsite])
  @@index([userId, createdAt])
  @@index([userId, normalizedWebsite])
}

model BrandProfile {
  id               String   @id @default(cuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brandName        String
  productSummary   String
  targetAudience   String
  customerProblems String[]
  keyBenefits      String[]
  proofPoints      String[]
  claimConstraints String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WebsiteAnalysis {
  id                       String   @id @default(cuid())
  projectId                String   @unique
  project                  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceUrl                String
  rootDomain               String
  homepage                 Json
  sourceContentFingerprint String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model HookConcept {
  id                    String       @id @default(cuid())
  projectId             String
  project               Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  angle                 String
  hookText              String
  hookImagePrompt       String
  demoCaptionsEnabled   Boolean?
  demoOverlayText       String
  videoDirection        String
  targetDurationLabel   String
  targetDurationSeconds Int
  score                 Int
  scoreLabel            String
  rationale             String
  generatedImageUrl     String?
  generatedVideoUrl     String?
  sortOrder             Int          @default(0)
  reviewDecision        ReviewDecision?
  assignedCreatorId     String?
  assignedClipId        String?
  assignedBrandDemoAssetId String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  selectedByProjects    Project[]    @relation("ProjectSelectedConcept")
  mediaAssets           MediaAsset[]
  socialPublications    SocialPublication[]

  @@index([projectId, sortOrder])
  @@index([projectId, reviewDecision, sortOrder])
  @@map("HookDraft")
}

model MediaAsset {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conceptId  String?      @map("scriptDraftId")
  concept    HookConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  type       MediaType
  provider   String
  providerId String?
  url        String
  mimeType   String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([projectId, createdAt])
}

model ProjectExport {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Creator {
  id                  String        @id @default(cuid())
  name                String
  description         String?
  baseImageUrl        String
  baseImageProvider   String
  baseImageProviderId String?
  baseImageMimeType   String?
  baseImageMetadata   Json?
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  clips               CreatorClip[]

  @@index([sortOrder, createdAt])
}

model CreatorClip {
  id         String   @id @default(cuid())
  creatorId  String
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title      String?
  url        String
  provider   String
  providerId String?
  mimeType   String?
  metadata   Json?
  tags       String[]
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([creatorId, sortOrder])
  @@index([createdAt])
}

model GenerationJob {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type            JobType
  status          JobStatus @default(QUEUED)
  progress        Int       @default(0)
  progressMessage String?
  input           Json
  result          Json?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  renderUsageReservation RenderUsageReservation?
  socialPublications SocialPublication[]

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model SocialProfile {
  id                String          @id @default(uuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  zernioProfileId   String          @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  accounts          SocialAccount[]
}

model SocialAccount {
  id                String                 @id @default(uuid())
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialProfileId   String
  socialProfile     SocialProfile          @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)
  platform          SocialPlatform
  zernioAccountId   String                 @unique
  username          String?
  displayName       String?
  avatarUrl         String?
  countryCode       String?
  connectionStatus  SocialConnectionStatus @default(CONNECTED)
  metadata          Json?
  connectedAt       DateTime               @default(now())
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  publications      SocialPublication[]

  @@unique([userId, platform])
  @@index([socialProfileId])
}

model SocialPublication {
  id                 String                  @id @default(uuid())
  requestKey         String                  @unique
  projectId          String
  project            Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conceptId          String?
  concept            HookConcept?            @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  renderJobId        String?
  renderJob          GenerationJob?          @relation(fields: [renderJobId], references: [id], onDelete: SetNull)
  socialAccountId    String
  socialAccount      SocialAccount           @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  platform           SocialPlatform
  deliveryMode       SocialPublicationDeliveryMode @default(DIRECT)
  sourceUrl          String
  caption            String
  music              Json?
  settings           Json
  zernioPostId       String?                 @unique
  platformPostId     String?
  platformPostUrl    String?
  status             SocialPublicationStatus @default(VALIDATING)
  errorCode          String?
  errorMessage       String?
  analytics          Json?
  analyticsSyncedAt  DateTime?
  publishedAt        DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([projectId, createdAt])
  @@index([socialAccountId, createdAt])
  @@index([renderJobId, conceptId])
}

model SocialWebhookEvent {
  eventId       String   @id
  eventType     String
  payload       Json
  processedAt   DateTime?
  createdAt     DateTime @default(now())
}
